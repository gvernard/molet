#!/bin/bash


map_path=$1
out_path=$2
api_status=$3

json_maps=`grep -o '^[^//]*' ${out_path}output/gerlumph_maps.json`

missing=()
Nq=`echo $json_maps |  @AM_JQ@ '. | length'`
for (( q=0; q<$Nq; q++ ))
do  
    id=$(echo $json_maps | @AM_JQ@ ".[$q].id " | @SED@ -e 's/^"//' -e 's/"$//')
    if [ $id != "none" ]
    then
	mydir=${map_path}$id
	if [ ! -d "$mydir" ]
	then
	    missing+=("$id")
	fi
    fi
done




if [ ${#missing[@]} -ne 0 ]
then

    if [ "$api_status" == "true" ]
    then
    
	echo "${#missing[@]} map(s) will be downloaded from the GERLUMPH api."

	query_args=$(echo '{}' | @AM_JQ@ --jsonargs '.ids = $ARGS.positional' "${missing[@]}")
	#echo $query_args
	    
    	response=$(curl -s -u "$GERLUMPH_username:$GERLUMPH_password" -X POST $GERLUMPH_api_fetch -H "Content-Type: application/json" -d "$query_args")
	#echo $response

	message=$(echo "$response" |  @AM_JQ@ '.message' | @SED@ -e 's/^"//' -e 's/"$//')
	if [[ "$message" == "success" ]]
	then
	    length=$(echo "$response" |  @AM_JQ@ '.map_links | length')
	    for ((i=0; i<length; i++)); do
		mkdir ${map_path}${missing[$i]}
		
		map_link=$(echo "$response" |  @AM_JQ@ -c --argjson idx "$i" '.map_links[$idx]')
		clean_link=${map_link//\"/}
		wget -q --show-progress -O ${map_path}${missing[$i]}/map.bin $clean_link
		
		meta_link=$(echo "$response" |  @AM_JQ@ -c --argjson idx "$i" '.meta_links[$idx]')
		clean_link=${meta_link//\"/}
		wget -q --show-progress -O ${map_path}${missing[$i]}/mapmeta.dat $clean_link
	    done
	else
	    echo "Something went wrong! Here is the error:" >&2
	    echo $message >&2
	    exit 1
	fi

    else

	echo "${#missing[@]} maps are missing and need to be downloaded, but the GERLUMPH api is currently offline."
	echo "Please either wait, rerun MOLET with different options, or contact the admins if you think this is a mistake."
	exit 1
	
    fi
fi


